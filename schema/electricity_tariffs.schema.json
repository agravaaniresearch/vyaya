{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Vyaya state electricity tariffs",
  "type": "object",
  "required": [
    "meta",
    "rows"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "description",
        "dataVersion"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "dataVersion": {
          "type": "string"
        }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "state",
          "code",
          "category",
          "landedInrPerKwh",
          "status",
          "sources",
          "lastVerified",
          "tariffYear",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "category": {
            "type": "string",
            "not": {
              "pattern": "[Dd]omestic|[Rr]esidential"
            }
          },
          "landedInrPerKwh": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 50
          },
          "status": {
            "enum": [
              "statutory",
              "secondary",
              "placeholder",
              "missing",
              "verified"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lastVerified": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "tariffYear": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}